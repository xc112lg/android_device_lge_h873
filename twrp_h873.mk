# Device identifier. This must come after all inclusions
PRODUCT_DEVICE := h873
PRODUCT_NAME := twrp_h873
PRODUCT_BRAND := lge
PRODUCT_MODEL := LG-H873
PRODUCT_MANUFACTURER := lge
